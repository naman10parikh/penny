{
  "name": "penny",
  "version": "0.1.0",
  "description": "Payments/billing domain-expert employee — wires Stripe test-mode billing, reviews against 21 known pitfalls, issues scoped agent-spend. Powered by Energy.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "penny": "./bin/penny.js",
    "penny-mcp": "./dist/mcp/server.js"
  },
  "main": "./dist/cli/index.js",
  "types": "./dist/cli/index.d.ts",
  "files": [
    "dist/",
    "bin/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "eval": "tsx eval/run.ts",
    "test:acceptance": "vitest run test/acceptance",
    "mcp": "node dist/mcp/server.js",
    "rsi": "node workflows/rsi.workflow.js --deterministic",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "claude",
    "agent",
    "payments",
    "billing",
    "stripe",
    "dev-tools",
    "energy"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@stripe/agent-toolkit": "^0.7.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "stripe": "^17.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "e2b": "^2.29.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
