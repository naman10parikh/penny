# wikimem
.wikimem-cache/
node_modules/

# Build output (regenerated by `pnpm build`; published via package.json "files", not git)
dist/

# Playwright runtime artifacts (the cockpit E2E; the kept screenshots live in content/screenshots/)
test-results/
playwright-report/
.playwright/
*.tsbuildinfo

# WikiMem test vault personal data
my-wiki/raw/
tools/agentgrid/app/release/

packages/web/.next/
*.pack

# macOS metadata
**/.DS_Store

# Ephemeral harness state (never commit)
.claude/worktrees/
.claude/backups/
.claude/scheduled_tasks.lock
.claude/vp-signals/*.done
.claude/vp-signals/*.needs-qa
.claude/vp-signals/*.migrating
hooks/billing-guard.log
.rsi/

# Obsidian temp files
vault/Untitled*.base

.env
.env.*
